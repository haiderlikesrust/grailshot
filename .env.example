# Copy to .env. The application starts locally without credentials.
MAINNET_ENABLED=false
HOST=127.0.0.1
PORT=4100
# Leave 0 locally. The Dokploy compose file configures the two proxy hops.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
# Set only when the game socket uses a different URL (also rebuild the frontend).
# NEXT_PUBLIC_GAME_WS_URL=ws://localhost:4100/api/ws
# Omit DATABASE_URL for persistent embedded Postgres in .data (local only).
# DATABASE_URL=postgres://grailshot:grailshot_local@127.0.0.1:54329/grailshot
MEMECOIN_MINT=
OWNER_WALLET=
FEE_RECIPIENT=
# Backend only. Paste a base58 Solana private key here; never use a NEXT_PUBLIC_ prefix.
# A JSON array of 64 byte values is also supported. Leave blank for local practice.
TREASURY_PRIVATE_KEY=
SOLANA_RPC_URL=
JUPITER_API_KEY=
COLLECTOR_CRYPT_API_KEY=
# Verify this public recipient address with Collector Crypt before enabling payments.
COLLECTOR_CRYPT_PAYMENT_WALLET=
CARDS_MINT=CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Daily spending is unlimited by default. Optional limits are saved in /admin.
GAS_RESERVE_SOL=0.05
SLIPPAGE_BPS=100
